generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Expense {
  id        String    @id @default(cuid())
  title     String
  amount    Float
  paidBy    String
  date      DateTime  @default(now())
  createdAt DateTime  @default(now())
  splitType String
  deletedAt  DateTime?
  resolvedAt DateTime?
  currency       String  @default("VND")
  originalAmount Float?
  fxRate         Float?
  splits     Split[]
}

// Global app settings (e.g. SGD->VND rate), key/value.
model Setting {
  key   String @id
  value String
}

model Split {
  id        String  @id @default(cuid())
  expenseId String
  member    String
  amount    Float
  paidBack  Boolean @default(false)
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}
